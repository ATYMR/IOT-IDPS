.coverage
htmlcov/

# --- generated data, models, reports, logs ---
data/*
!data/README.md
models/*
!models/README.md
reports/
logs/
*.log
*.jsonl
*.joblib

# --- PlatformIO / firmware builds ---
firmware/.pio/
firmware/.vscode/
*.bin
*.elf

