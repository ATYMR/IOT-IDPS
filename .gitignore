firmware/include/secrets.h
*.pem
*.key
*.crt
!deploy/**/*.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
