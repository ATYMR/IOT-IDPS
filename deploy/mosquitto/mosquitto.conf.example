# Minimal hardened Mosquitto 2.x configuration for this project.
# Copy to mosquitto.conf, create the password file and ACL, then:
#   mosquitto_passwd -c passwd idps-backend
#   mosquitto_passwd    passwd esp32_01
#   mosquitto -c mosquitto.conf

per_listener_settings false
allow_anonymous false
password_file /mosquitto/config/passwd
acl_file /mosquitto/config/acl

# Plain MQTT only on localhost (for the backend running on the same host).
listener 1883 127.0.0.1

# TLS for devices on the network. Point these at your own CA/server cert.
listener 8883
cafile /mosquitto/certs/ca.crt
certfile /mosquitto/certs/server.crt
keyfile /mosquitto/certs/server.key
tls_version tlsv1.2

# Basic flood resistance.
max_inflight_messages 20
max_queued_messages 100
message_size_limit 2048
max_connections 100

log_type error
log_type warning
log_type notice
connection_messages true
