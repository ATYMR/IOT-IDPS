# Copy to .env and edit. .env is git-ignored; never commit real values.
# Validate with:  python -m idps check-config

# --- MQTT broker (use your own broker, not a public test broker) ---
IDPS_MQTT_HOST=localhost
IDPS_MQTT_PORT=1883
IDPS_MQTT_USERNAME=
IDPS_MQTT_PASSWORD=
# Set to true (and usually port 8883) for TLS. CA file is optional when the
# broker certificate chains to the system trust store.
IDPS_MQTT_TLS=false
IDPS_MQTT_CA_FILE=
IDPS_MQTT_CLIENT_ID=idps-backend
IDPS_TOPIC_PREFIX=idps/v1

# --- Devices: comma-separated device_id:hexkey pairs ---
# Generate one per device with:  python -m idps gen-key --device-id esp32_01
IDPS_DEVICE_KEYS=

# --- Behaviour ---
# detect  = IDS only: log + alert, never acts (default)
# prevent = may send authenticated QUARANTINE commands to devices
IDPS_MODE=detect
IDPS_MODEL_PATH=models/isolation_forest.joblib
IDPS_ALERT_LOG=logs/alerts.jsonl
# Must match IDPS_TELEMETRY_INTERVAL_MS / 1000 in firmware/include/idps_config.h
IDPS_TELEMETRY_INTERVAL_S=5

# --- Experimental host firewall responder (needs root/admin when not dry-run) ---
IDPS_FIREWALL_ENABLED=false
IDPS_FIREWALL_DRY_RUN=true
